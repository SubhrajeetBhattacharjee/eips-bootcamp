generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String                 @id @default(cuid())
  email                 String                 @unique
  username              String?                @unique
  walletAddress         String?                @unique
  role                  UserRole               @default(STUDENT)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  emailVerified         Boolean                @default(false)
  image                 String?
  name                  String?
  currentLeagueTier     LeagueTier             @default(BRONZE)
  accounts              Account[]
  achievements          UserAchievement[]
  assignmentSubmissions AssignmentSubmission[]
  capApplication        CAPApplication?
  communityParticipations CommunityChallengeParticipant[]
  competitionCertificates CompetitionCertificate[]
  competitionParticipations CompetitionParticipant[]
  dailyQuests           UserDailyQuest[]
  leagueMemberships     LeagueMember[]
  lessonProgress        LessonProgress[]
  moduleSubscriptions   ModuleSubscription[]
  nftRewards            NftReward[]
  profile               Profile?
  referredBy            Referral?
  referralCode          ReferralCode?
  rewardRedemptions     RewardRedemption[]
  seasonSnapshots       SeasonUserSnapshot[]
  sessions              Session[]
  streak                UserStreak?
  xpTransactions        XPTransaction[]
}

model Profile {
  id        String  @id @default(cuid())
  userId    String  @unique
  fullName  String?
  college   String?
  year      Int?
  city      String?
  country   String?
  avatarUrl String?
  bio       String?
  github    String?
  hobbies   String?
  linkedin  String?
  twitter   String?
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@unique([identifier, value])
  @@index([identifier])
}

model CAPApplication {
  id                  String            @id @default(cuid())
  userId              String            @unique
  fullName            String
  college             String
  graduationYear      Int
  city                String
  socialLinks         String?
  whyJoin             String
  communityExperience String?
  status              ApplicationStatus @default(PENDING)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ReferralCode {
  id        String     @id @default(cuid())
  code      String     @unique
  userId    String     @unique
  clicks    Int        @default(0)
  createdAt DateTime   @default(now())
  referrals Referral[]
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Referral {
  id             String         @id @default(cuid())
  referralCodeId String
  referredUserId String         @unique
  status         ReferralStatus @default(JOINED)
  createdAt      DateTime       @default(now())
  referralCode   ReferralCode   @relation(fields: [referralCodeId], references: [id], onDelete: Cascade)
  referredUser   User           @relation(fields: [referredUserId], references: [id], onDelete: Cascade)
}

model XPTransaction {
  id          String   @id @default(cuid())
  userId      String
  amount      Int
  reason      String
  category    String   @default("GENERAL")
  referenceId String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, referenceId])
  @@index([userId])
  @@index([userId, category])
  @@index([createdAt])
}

model Module {
  id            String               @id @default(cuid())
  title         String
  description   String
  xpReward      Int
  duration      String
  color         String
  orderIndex    Int
  createdAt     DateTime             @default(now())
  thumbnailUrl  String?
  category      String               @default("Beginner")
  isPremium     Boolean              @default(false)
  price         Int                  @default(0)
  events        Event[]
  lessons       Lesson[]
  subscriptions ModuleSubscription[]
}

model ModuleSubscription {
  id        String   @id @default(cuid())
  userId    String
  moduleId  String
  createdAt DateTime @default(now())
  module    Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleId])
}

model Event {
  id          String   @id @default(cuid())
  title       String
  description String
  link        String
  date        DateTime
  moduleId    String
  createdAt   DateTime @default(now())
  module      Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
}

model Lesson {
  id          String           @id @default(cuid())
  moduleId    String
  title       String
  description String
  duration    String
  content     String?
  orderIndex  Int
  createdAt   DateTime         @default(now())
  module      Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress    LessonProgress[]
}

model LessonProgress {
  id          String   @id @default(cuid())
  userId      String
  lessonId    String
  completedAt DateTime @default(now())
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

model Assignment {
  id              String                 @id @default(cuid())
  title           String
  module          String
  description     String
  difficulty      String
  xpReward        Int
  deadline        DateTime
  estimatedTime   Float
  tags            String[]
  createdAt       DateTime               @default(now())
  questionFileUrl String?
  submissions     AssignmentSubmission[]
}

model AssignmentSubmission {
  id           String           @id @default(cuid())
  assignmentId String
  userId       String
  content      String?
  status       SubmissionStatus @default(NOT_STARTED)
  progress     Int              @default(0)
  feedback     String?
  score        Int?
  submittedAt  DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  assignment   Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, assignmentId])
}

model Reward {
  id          String             @id @default(cuid())
  title       String
  description String
  cost        Int
  category    String
  badge       String
  image       String
  available   Boolean            @default(true)
  createdAt   DateTime           @default(now())
  redemptions RewardRedemption[]
}

model RewardRedemption {
  id         String   @id @default(cuid())
  userId     String
  rewardId   String
  xpSpent    Int
  redeemedAt DateTime @default(now())
  reward     Reward   @relation(fields: [rewardId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum UserRole {
  STUDENT
  AMBASSADOR
  ADMIN
  MENTOR
}

enum ApplicationStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum ReferralStatus {
  JOINED
  ONBOARDED
}

enum SubmissionStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  UNDER_REVIEW
  COMPLETED
  OVERDUE
}

enum LeagueTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
  DIAMOND
  MASTER
}

enum LeagueStatus {
  ACTIVE
  FINALIZED
}

model WeeklyLeague {
  id          String         @id @default(cuid())
  tier        LeagueTier     @default(BRONZE)
  cohortIndex Int            @default(1)
  weekNumber  Int
  year        Int
  startDate   DateTime
  endDate     DateTime
  status      LeagueStatus   @default(ACTIVE)
  createdAt   DateTime       @default(now())
  members     LeagueMember[]

  @@unique([tier, cohortIndex, weekNumber, year])
  @@index([status, endDate])
  @@index([tier, status])
}

model LeagueMember {
  id          String       @id @default(cuid())
  leagueId    String
  userId      String
  weeklyXp    Int          @default(0)
  initialRank Int?
  finalRank   Int?
  promoted    Boolean      @default(false)
  demoted     Boolean      @default(false)
  joinedAt    DateTime     @default(now())
  league      WeeklyLeague @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([leagueId, userId])
  @@index([leagueId, weeklyXp(sort: Desc)])
  @@index([userId])
}

enum CompetitionStatus {
  UPCOMING
  ACTIVE
  COMPLETED
}

enum CompetitionDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum ParticipantStatus {
  REGISTERED
  IN_PROGRESS
  SUBMITTED
}

model Competition {
  id              String                   @id @default(cuid())
  title           String
  slug            String                   @unique
  description     String
  difficulty      CompetitionDifficulty    @default(INTERMEDIATE)
  status          CompetitionStatus        @default(UPCOMING)
  startTime       DateTime
  endTime         DateTime
  durationMinutes Int                      @default(60)
  totalPoints     Int                      @default(300)
  xpReward        Int                      @default(200)
  rules           String?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  problems        CompetitionProblem[]
  participants    CompetitionParticipant[]
  certificates    CompetitionCertificate[]
  nftRewards      NftReward[]

  @@index([status, startTime])
}

model CompetitionProblem {
  id            String                  @id @default(cuid())
  competitionId String
  title         String
  orderIndex    Int                     @default(1)
  description   String
  codeSnippet   String?
  type          String                  @default("MULTIPLE_CHOICE")
  options       Json?
  correctOption String
  points        Int                     @default(100)
  explanation   String?
  competition   Competition             @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  submissions   CompetitionSubmission[]

  @@index([competitionId, orderIndex])
}

model CompetitionParticipant {
  id               String                  @id @default(cuid())
  competitionId    String
  userId           String
  status           ParticipantStatus       @default(REGISTERED)
  registeredAt     DateTime                @default(now())
  startedAt        DateTime?
  submittedAt      DateTime?
  score            Int                     @default(0)
  timeTakenSeconds Int                     @default(0)
  rank             Int?
  xpAwarded        Int                     @default(0)
  competition      Competition             @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  user             User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  submissions      CompetitionSubmission[]

  @@unique([competitionId, userId])
  @@index([competitionId, score(sort: Desc), timeTakenSeconds(sort: Asc)])
  @@index([userId])
}

model CompetitionSubmission {
  id            String                 @id @default(cuid())
  participantId String
  problemId     String
  answer        String
  isCorrect     Boolean                @default(false)
  scoreEarned   Int                    @default(0)
  submittedAt   DateTime               @default(now())
  participant   CompetitionParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  problem       CompetitionProblem     @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([participantId, problemId])
  @@index([participantId])
}

enum AchievementCategory {
  LEARNING
  COMPETITION
  LEAGUE
  ENGAGEMENT
}

enum AchievementRarity {
  COMMON
  RARE
  EPIC
  LEGENDARY
}

model Achievement {
  id          String              @id @default(cuid())
  code        String              @unique
  title       String
  description String
  category    AchievementCategory @default(LEARNING)
  rarity      AchievementRarity   @default(COMMON)
  icon        String
  xpReward    Int                 @default(50)
  maxProgress Int                 @default(1)
  createdAt   DateTime            @default(now())
  users       UserAchievement[]

  @@index([category])
}

model UserAchievement {
  id            String      @id @default(cuid())
  userId        String
  achievementId String
  progress      Int         @default(0)
  isUnlocked    Boolean     @default(false)
  unlockedAt    DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId, isUnlocked])
}

enum CertificateType {
  COMPLETION
  DISTINCTION
  PODIUM
  CHAMPION
}

model CompetitionCertificate {
  id                String          @id @default(cuid())
  certificateNumber String          @unique
  userId            String
  competitionId     String
  type              CertificateType @default(COMPLETION)
  recipientName     String
  title             String
  score             Int
  totalPoints       Int
  rank              Int?
  timeTakenSeconds  Int
  issuedAt          DateTime        @default(now())
  metadata          Json?
  competition       Competition     @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, competitionId])
  @@index([certificateNumber])
  @@index([userId])
}

enum NftRewardType {
  ARENA_CHAMPION
  PODIUM_FINISHER
  DIVISION_TITAN
  PROTOCOL_ARCHITECT
  SEASON_HONOR
}

enum NftRewardStatus {
  ELIGIBLE
  CLAIMING
  MINTED
  FAILED
}

model NftReward {
  id              String          @id @default(cuid())
  userId          String
  competitionId   String?
  title           String
  description     String
  badgeImage      String
  type            NftRewardType
  status          NftRewardStatus @default(ELIGIBLE)
  tier            String          @default("LEGENDARY")
  contractAddress String?
  tokenId         String?
  txHash          String?
  walletAddress   String?
  claimedAt       DateTime?
  metadata        Json?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  competition     Competition?    @relation(fields: [competitionId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([userId])
  @@index([status])
}

model UserDailyQuest {
  id           String    @id @default(cuid())
  userId       String
  date         String    // YYYY-MM-DD UTC
  questKey     String    // DAILY_LESSON, XP_GOAL, ARENA_PRACTICE
  title        String
  description  String
  targetCount  Int       @default(1)
  currentCount Int       @default(0)
  xpReward     Int       @default(30)
  isCompleted  Boolean   @default(false)
  isClaimed    Boolean   @default(false)
  completedAt  DateTime?
  claimedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date, questKey])
  @@index([userId, date])
}

model UserStreak {
  id                    String    @id @default(cuid())
  userId                String    @unique
  currentStreak         Int       @default(1)
  longestStreak         Int       @default(1)
  lastActiveDate        String    // YYYY-MM-DD UTC
  streakFreezesAvailable Int      @default(1)
  streakFreezeUsedToday Boolean   @default(false)
  freezeExpiresAt       DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum ChallengeCategory {
  LEARNING
  COMPETITION
  ASSIGNMENT
  COMMUNITY
}

enum ChallengeStatus {
  UPCOMING
  ACTIVE
  COMPLETED
  EXPIRED
}

model CommunityChallenge {
  id              String                          @id @default(cuid())
  slug            String                          @unique
  title           String
  description     String
  category        ChallengeCategory               @default(LEARNING)
  status          ChallengeStatus                 @default(ACTIVE)
  targetCount     Int                             @default(1000)
  currentCount    Int                             @default(0)
  minContribution Int                             @default(1)
  xpReward        Int                             @default(150)
  rewardBadge     String?
  bannerImage     String?
  startDate       DateTime                        @default(now())
  endDate         DateTime
  createdAt       DateTime                        @default(now())
  updatedAt       DateTime                        @updatedAt
  participants    CommunityChallengeParticipant[]

  @@index([status, endDate])
  @@index([slug])
}

model CommunityChallengeParticipant {
  id                String             @id @default(cuid())
  challengeId       String
  userId            String
  contributionCount Int                @default(0)
  isClaimed         Boolean            @default(false)
  claimedAt         DateTime?
  joinedAt          DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  challenge         CommunityChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([challengeId, userId])
  @@index([challengeId])
  @@index([userId])
}


enum SeasonStatus {
  UPCOMING
  ACTIVE
  ARCHIVED
}

model Season {
  id           String               @id @default(cuid())
  slug         String               @unique
  name         String
  description  String
  status       SeasonStatus         @default(ACTIVE)
  startDate    DateTime             @default(now())
  endDate      DateTime
  xpMultiplier Float                @default(1.0)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  snapshots    SeasonUserSnapshot[]

  @@index([status, endDate])
  @@index([slug])
}

model SeasonUserSnapshot {
  id                 String   @id @default(cuid())
  seasonId           String
  userId             String
  rank               Int
  seasonalXp         Int      @default(0)
  contestsCompleted  Int      @default(0)
  tier               String   @default("GOLD")
  rewardClaimed      Boolean  @default(false)
  rewardXp           Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  season             Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([seasonId, userId])
  @@index([seasonId, rank])
  @@index([userId])
}
